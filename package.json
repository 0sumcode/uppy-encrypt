{
  "name": "uppy-encrypt",
  "version": "2.0.1",
  "description": "Uppy plugin to encrypt and decrypt files in the browser before upload using libsodium-wrappers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:uppy3": "npm i --no-save @uppy/core@^3.7.1 && vitest run; npm i --no-save @uppy/core@^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0sumcode/uppy-encrypt.git"
  },
  "keywords": [
    "uppy",
    "encrypt",
    "decrypt",
    "libsodium"
  ],
  "author": "Dan Stevens",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/0sumcode/uppy-encrypt/issues"
  },
  "homepage": "https://github.com/0sumcode/uppy-encrypt#readme",
  "devDependencies": {
    "@uppy/core": "^4.0.0",
    "happy-dom": "^20.8.9",
    "ts-node": "^10.9.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@uppy/core": "^3.7.1 || ^4.0.0"
  },
  "dependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "libsodium-wrappers-sumo": "^0.7.13"
  }
}
